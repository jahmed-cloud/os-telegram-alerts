TG_CHAT="{{ OPNsense.TelegramAlerts.general.chatid|default('') }}"
TG_PREFIX="{{ OPNsense.TelegramAlerts.general.prefix|default('[OPNsense]') }}"
TG_TEMP_MAX="{{ OPNsense.TelegramAlerts.general.tempmax|default('80') }}"
TG_NETWATCH="{{ OPNsense.TelegramAlerts.general.netwatch|default('1') }}"
TG_UPDATES="{{ OPNsense.TelegramAlerts.general.updates|default('1') }}"
TG_LOGINS="{{ OPNsense.TelegramAlerts.general.logins|default('1') }}"
TG_CONFIGCHANGE="{{ OPNsense.TelegramAlerts.general.configchange|default('1') }}"
TG_NEWDEVICES="{{ OPNsense.TelegramAlerts.general.newdevices|default('1') }}"
TG_IDS="{{ OPNsense.TelegramAlerts.general.ids|default('1') }}"
TG_WIREGUARD="{{ OPNsense.TelegramAlerts.general.wireguard|default('1') }}"
TG_LATENCYMAX="{{ OPNsense.TelegramAlerts.general.latencymax|default('100') }}"
TG_LOSSMAX="{{ OPNsense.TelegramAlerts.general.lossmax|default('5') }}"
TG_BACKUP="{{ OPNsense.TelegramAlerts.general.backup|default('0') }}"
TG_RESOURCES="{{ OPNsense.TelegramAlerts.general.resources|default('1') }}"
TG_GATEWAYDOWN="{{ OPNsense.TelegramAlerts.general.gatewaydown|default('1') }}"
TG_TEMPERATURE="{{ OPNsense.TelegramAlerts.general.temperature|default('1') }}"
TG_SMART="{{ OPNsense.TelegramAlerts.general.smart|default('1') }}"
TG_WANQUALITY="{{ OPNsense.TelegramAlerts.general.wanquality|default('1') }}"
TG_DAILY="{{ OPNsense.TelegramAlerts.general.daily|default('1') }}"
TG_BACKUPPASS="{{ OPNsense.TelegramAlerts.general.backuppass|default('') }}"
{% else %}
